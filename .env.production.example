# Copy to .env.production ON THE SERVER (never commit actual values).
# Generate fresh random 64-character hex values for both AUTH_* variables.
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_ALEATORIO
AUTH_OTP_PEPPER=REEMPLAZAR_CON_64_HEX_ALEATORIOS
AUTH_JWT_SIGNING_KEY=REEMPLAZAR_CON_64_HEX_ALEATORIOS

# HTTPS public URL and host-local HTTP port for the trusted TLS reverse proxy.
PUBLIC_ORIGIN=https://logisticacastrofallas.com
PRODUCTION_HTTP_PORT=8080

# Optional: exact, verified reverse-proxy IPs seen by the backend.
# Leave blank until the deployment topology has been checked. Do not trust
# arbitrary forwarded headers, clients, Cloudflare ranges or broad subnets.
RATE_LIMIT_TRUSTED_PROXY_IP_0=
RATE_LIMIT_TRUSTED_PROXY_IP_1=

# Choose Smtp or Graph. Do not use LocalOutbox in production.
EMAIL_MODE=Smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=StartTls
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM=

# Optional providers; leave blank to disable their integrations.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MONGO_CONNECTION_STRING=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=castrofallas-media
