# /opt/dhole/pangolin.env (solo configuracion operativa, NO codigo fuente)
# Copiar estos nombres al archivo privado en AlmaLinux, con permisos 600.
# No subir el archivo real a GitHub ni compartir sus valores.

PANGOLIN_POSTGRES_PASSWORD=CAMBIAR_CON_UN_SECRETO_ALEATORIO_DE_20_CARACTERES_O_MAS
AUTH_OTP_PEPPER=GENERAR_64_CARACTERES_HEXADECIMALES
AUTH_JWT_SIGNING_KEY=OTROS_64_CARACTERES_HEXADECIMALES

PUBLIC_ORIGIN=https://logisticacastrofallas.com
PANGOLIN_HOST=logisticacastrofallas.com
PANGOLIN_WWW_HOST=www.logisticacastrofallas.com
DHOLE_NETWORK=dhole
PANGOLIN_LOCAL_PORT=8180
# Importante: no habilitar mientras Fennec sirva el mismo Host.
PANGOLIN_TRAEFIK_ENABLED=false

# Microsoft Graph (Application Mail.Send, consentimiento administrativo y acceso al buzon FROM).
EMAIL_MODE=Graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM=

# Si se usa SMTP en vez de Graph, elegir EMAIL_MODE=Smtp y configurar SMTP_*
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=StartTls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Opcionales
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MONGO_CONNECTION_STRING=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=castrofallas-media
