# ANEXO A /opt/dhole/.env (archivo EXISTENTE; no crear /opt/dhole/pangolin.env)
# NO subir el .env real a GitHub ni compartirlo.
# Pangolin reutiliza las variables de Dhole:
# POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_PASSWORD,
# REDIS_CONNECTION_STRING, MONGO_CONNECTION_STRING, DHOLE_NETWORK,
# TRAEFIK_ROUTER_PREFIX, FENNEC_HOST, FENNEC_WWW_HOST y FENNEC_PUBLIC_URL.
#
# No se crea otro contenedor permanente de PostgreSQL ni Redis.
# GitHub Actions crea una base "pangolin" y un rol "pangolin" en la
# instancia PostgreSQL compartida; su contrasena es INDEPENDIENTE.
#
# Generar contrasena de PostgreSQL con: openssl rand -hex 24
# Generar cada secreto de autentificacion con: openssl rand -hex 32
PANGOLIN_POSTGRES_PASSWORD=REEMPLAZAR_POR_48_HEXADECIMALES
PANGOLIN_AUTH_OTP_PEPPER=REEMPLAZAR_POR_64_HEXADECIMALES
PANGOLIN_AUTH_JWT_SIGNING_KEY=REEMPLAZAR_POR_OTROS_64_HEXADECIMALES

# Preview privado; NO apuntar el dominio a Pangolin aun.
PANGOLIN_LOCAL_PORT=8180
PANGOLIN_TRAEFIK_ENABLED=false

# OTP y notificaciones de Pangolin: NO reutilizar el SMTP de extraccion.
# La app de Microsoft Graph debe tener Mail.Send y permiso sobre FROM.
PANGOLIN_EMAIL_MODE=Graph
PANGOLIN_GRAPH_TENANT_ID=
PANGOLIN_GRAPH_CLIENT_ID=
PANGOLIN_GRAPH_CLIENT_SECRET=
PANGOLIN_GRAPH_FROM=tracking@grupocastrofallas.com

# Alternativa si se configura correo SMTP exclusivo para Pangolin:
# PANGOLIN_EMAIL_MODE=Smtp
# PANGOLIN_SMTP_HOST=
# PANGOLIN_SMTP_PORT=587
# PANGOLIN_SMTP_TLS=StartTls
# PANGOLIN_SMTP_FROM=
# PANGOLIN_SMTP_USERNAME=
# PANGOLIN_SMTP_PASSWORD=

# Instagram profesional de Grupo Castro Fallas. Token privado de Instagram Login.
# Cuando esté configurado, el Home obtiene el Reel más reciente con caché.
# Revisar su vencimiento y renovación en Meta. Nunca subir el token al repositorio.
PANGOLIN_INSTAGRAM_ACCESS_TOKEN=

# GIO y traducciones de noticias/tracking: clave corporativa dedicada a producción.
# Sustituir la clave existente y recrear sólo backend con el tag activo; no desplegar.
# Guía, preflight y recuperación: docs/GIO-GROQ-HANDOVER.md.
# No añadir una segunda clave ni copiar el .env local sobre el oficial.
PANGOLIN_GROQ_API_KEY=
PANGOLIN_GROQ_MODEL=openai/gpt-oss-20b

# Catálogos públicos de Dhole para cotizaciones; la clave NO se publica en Vue.
# No asumir que la API key de tracking permite consultar catálogos.
# Paso 1 (solo GET): después de verificar la API key, poner ENABLED=true;
# dejar FORM/SUBMISSION/ITINERARIES en false hasta comprobar las 7 APIs.
# Paso 2 (formulario): tras verificar las 5 modalidades, poner
# FORM_ENABLED=true Y SUBMISSION_ENABLED=true simultáneamente.
# Esto habilita la validación en servidor y deja de aceptar catálogos locales.
# Itinerarios se activa aparte; no afecta al seguimiento de embarques.
PANGOLIN_DHOLE_CATALOGS_ENABLED=false
PANGOLIN_DHOLE_CATALOGS_API_KEY=
PANGOLIN_DHOLE_CATALOGS_FORM_ENABLED=false
PANGOLIN_DHOLE_CATALOGS_SUBMISSION_ENABLED=false
PANGOLIN_DHOLE_CATALOGS_ITINERARIES_ENABLED=false

# MinIO de Dhole existe en http://minio:9000 en red dhole.
# Crear/verificar bucket y usar un usuario IAM dedicado, nunca la cuenta root.
# Si no hay keys IAM, dejar ENDPOINT vacio para no habilitar S3 parcialmente.
PANGOLIN_S3_ENDPOINT=
PANGOLIN_S3_ACCESS_KEY=
PANGOLIN_S3_SECRET_KEY=
PANGOLIN_S3_BUCKET=castrofallas-media

# Official quote direct dispatch (explicit activation only AFTER schema backup,
# pilot and owner approval). No pilot ID in production; only new jobs after cutoff.
# Never copy real credentials into this example or share actual .env.
PANGOLIN_DHOLE_DIRECT_OUTBOX_ENABLED=false
PANGOLIN_DHOLE_CLIENT_IDEMPOTENCY_ENABLED=false
PANGOLIN_DHOLE_WORKER_ENABLED=false
PANGOLIN_DHOLE_DISPATCHER_ENABLED=false
PANGOLIN_DHOLE_CLAIM_ENABLED=false
PANGOLIN_DHOLE_OUTCOME_ENABLED=false
PANGOLIN_DHOLE_POST_ENABLED=false
PANGOLIN_DHOLE_POST_API_KEY=
PANGOLIN_DHOLE_CONTACT_SHARING_APPROVED=false
PANGOLIN_DHOLE_ALL_NEW_QUOTES_ENABLED=false
PANGOLIN_DHOLE_NEW_QUOTES_START_UTC=
PANGOLIN_DHOLE_TEMPORARY_CATALOGS_ENABLED=false
# Optional UTC expiry; empty means no calendar cutoff while temporary mode is explicitly enabled.
PANGOLIN_DHOLE_TEMPORARY_CATALOGS_VALID_UNTIL_UTC=
# Express rollout: set true only when explicitly activating the approved direct flow.
# Preserve original declared amount/currency in Pricing notes; no FX/insurance calculation.
PANGOLIN_DHOLE_MANUAL_COMMERCIAL_REVIEW_ENABLED=false
PANGOLIN_DHOLE_ACCEPT_CREATION_RECEIPT_ENABLED=false
PANGOLIN_DHOLE_CONFIRMATION_EMAIL_ENABLED=false
PANGOLIN_DHOLE_VERIFICATION_ENABLED=false
PANGOLIN_DHOLE_VERIFICATION_PATH=
PANGOLIN_DHOLE_VERIFICATION_API_KEY=
