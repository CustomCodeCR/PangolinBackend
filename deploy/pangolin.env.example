# ANEXO A /opt/dhole/.env (archivo EXISTENTE; no crear /opt/dhole/pangolin.env)
# NO subir el .env real a GitHub ni compartirlo.
# Pangolin reutiliza las variables de Dhole:
# POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_PASSWORD,
# REDIS_CONNECTION_STRING, MONGO_CONNECTION_STRING, DHOLE_NETWORK,
# TRAEFIK_ROUTER_PREFIX, FENNEC_HOST, FENNEC_WWW_HOST y FENNEC_PUBLIC_URL.
#
# No se crea otro contenedor permanente de PostgreSQL ni Redis.
# GitHub Actions crea una base "pangolin" y un rol "pangolin" en la
# instancia PostgreSQL compartida; su contrasena es INDEPENDIENTE.
#
# Generar contrasena de PostgreSQL con: openssl rand -hex 24
# Generar cada secreto de autentificacion con: openssl rand -hex 32
PANGOLIN_POSTGRES_PASSWORD=REEMPLAZAR_POR_48_HEXADECIMALES
PANGOLIN_AUTH_OTP_PEPPER=REEMPLAZAR_POR_64_HEXADECIMALES
PANGOLIN_AUTH_JWT_SIGNING_KEY=REEMPLAZAR_POR_OTROS_64_HEXADECIMALES

# Preview privado; NO apuntar el dominio a Pangolin aun.
PANGOLIN_LOCAL_PORT=8180
PANGOLIN_TRAEFIK_ENABLED=false

# OTP y notificaciones de Pangolin: NO reutilizar el SMTP de extraccion.
# La app de Microsoft Graph debe tener Mail.Send y permiso sobre FROM.
PANGOLIN_EMAIL_MODE=Graph
PANGOLIN_GRAPH_TENANT_ID=
PANGOLIN_GRAPH_CLIENT_ID=
PANGOLIN_GRAPH_CLIENT_SECRET=
PANGOLIN_GRAPH_FROM=tracking@grupocastrofallas.com

# Alternativa si se configura correo SMTP exclusivo para Pangolin:
# PANGOLIN_EMAIL_MODE=Smtp
# PANGOLIN_SMTP_HOST=
# PANGOLIN_SMTP_PORT=587
# PANGOLIN_SMTP_TLS=StartTls
# PANGOLIN_SMTP_FROM=
# PANGOLIN_SMTP_USERNAME=
# PANGOLIN_SMTP_PASSWORD=

# GIO (opcional; usar clave rotada/dedicada)
PANGOLIN_GROQ_API_KEY=
PANGOLIN_GROQ_MODEL=openai/gpt-oss-20b

# MinIO de Dhole existe en http://minio:9000 en red dhole.
# Crear/verificar bucket y usar un usuario IAM dedicado, nunca la cuenta root.
# Si no hay keys IAM, dejar ENDPOINT vacio para no habilitar S3 parcialmente.
PANGOLIN_S3_ENDPOINT=
PANGOLIN_S3_ACCESS_KEY=
PANGOLIN_S3_SECRET_KEY=
PANGOLIN_S3_BUCKET=castrofallas-media
