# .env es privado, no se sube a GitHub.
# Ejecutar scripts/setup-docker.ps1 o scripts/setup-docker.sh para generar secretos.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_GENERADO
AUTH_OTP_PEPPER=CAMBIAR_SECRETO_GENERADO_DE_64_CARACTERES
AUTH_JWT_SIGNING_KEY=CAMBIAR_JWT_HEX_DE_64_CARACTERES

# Puertos del HOST (por defecto accesibles solo desde tu computadora).
# FRONTEND_BIND_IP no se define aquí: por defecto es 127.0.0.1.
# Para habilitar temporalmente visitas desde tu Wi-Fi, en PowerShell:
#   $env:FRONTEND_BIND_IP = "0.0.0.0"
# No expongas el servidor de desarrollo directamente a Internet.
FRONTEND_HOST_PORT=5173
# Optional: exact Tailscale Serve hostname only, without https:// or a trailing slash.
# Set locally in your private .env to enable HTTPS access via Tailscale Serve:
# TAILSCALE_HOST=your-pc.your-tailnet.ts.net
TAILSCALE_HOST=
BACKEND_HOST_PORT=5000
POSTGRES_HOST_PORT=5433

# Para colaborar sin cuentas de correo, LocalOutbox crea .eml en backend/local-outbox/
EMAIL_MODE=LocalOutbox
# Microsoft Graph (app-only OAuth 2.0). Completar SOLO en el .env privado.
# EMAIL_MODE=Graph habilita este proveedor; requiere Mail.Send Application + admin consent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM=tracking@grupocastrofallas.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=StartTls
SMTP_FROM=pruebas@castrofallas.local
SMTP_USERNAME=
SMTP_PASSWORD=
# Para activar Gmail: EMAIL_MODE=Smtp y completar SMTP_FROM/USERNAME/PASSWORD
# con contraseña de aplicación. No hacer commit de .env ni compartir OTP.

# Rastreo Dynamics por Dhole (previsualización administradores, desactivado por defecto).
# Clave privada del backend. Nunca la compartas en el chat ni la subas a GitHub.
DHOLE_TRACKING_ENABLED=false
DHOLE_TRACKING_API_KEY=

# Último Reel de @grupocastrofallas1: token de Instagram Login profesional.
# Opcional; sin token se muestra un enlace seguro al perfil.
# Generarlo con tu aplicación Meta; nunca compartirlo ni subirlo a GitHub.
INSTAGRAM_ACCESS_TOKEN=

# GIO con Groq Free: API key privada, solo en backend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# MinIO AIStor Free (opcional, sólo con compose.minio.yaml).
# Nunca subas la licencia o las credenciales a GitHub.
MINIO_ROOT_USER=GENERAR_USUARIO_ADMIN_MINIO
MINIO_ROOT_PASSWORD=GENERAR_PASSWORD_ADMIN_MINIO
S3_ACCESS_KEY=CREAR_CLAVE_APP_MINIO
S3_SECRET_KEY=CREAR_SECRETO_APP_MINIO
S3_BUCKET=castrofallas-media
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
