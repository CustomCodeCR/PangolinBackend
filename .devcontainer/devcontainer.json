{
  "name": "Castro Fallas - vista previa (PR 58)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Castro Fallas - vista web / admin",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cd frontend && npm ci",
  "postStartCommand": "bash -lc 'cd frontend && (nohup npm run dev -- --host 0.0.0.0 > /tmp/castrofallas-vite-preview.log 2>&1 < /dev/null &)'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
