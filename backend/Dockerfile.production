# Builds a self-contained publish directory; no SDK or source mounts at runtime.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY CastroFallas.MiniQuote.Api.csproj ./
RUN dotnet restore CastroFallas.MiniQuote.Api.csproj
COPY . .
RUN dotnet publish CastroFallas.MiniQuote.Api.csproj --configuration Release \
    --output /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish ./
ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000
USER $APP_UID
ENTRYPOINT ["dotnet", "CastroFallas.MiniQuote.Api.dll"]
